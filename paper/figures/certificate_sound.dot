digraph DFA {
    rankdir=LR;
    ratio=1.0;
    node [shape = circle];
    2 [shape = doublecircle, label="2 (1)"];
    1 [shape = doublecircle, label="1 (0)"];
    __start__ [shape = none, label=""];
    __start__ -> 0;
    0 -> 2 [label = ";"];
    0 -> 1 [label = "a"];
    1 -> 1 [label = "a"];
}
