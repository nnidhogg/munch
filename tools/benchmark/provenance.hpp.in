#ifndef MUNCH_TOOLS_BENCHMARK_PROVENANCE_HPP
#define MUNCH_TOOLS_BENCHMARK_PROVENANCE_HPP

#include <string_view>

namespace munch::tools::benchmark
{
/**
 * @brief The commit the benchmark was built from, or "unknown" outside a git checkout.
 */
inline constexpr std::string_view commit{"@commit@"};

/**
 * @brief Whether the checkout was dirty, which makes the commit a lower bound rather than an identification.
 */
inline constexpr bool dirty{@dirty@};

} // namespace munch::tools::benchmark

#endif // MUNCH_TOOLS_BENCHMARK_PROVENANCE_HPP
