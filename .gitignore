# Ignore IDE project files
/.idea

# Generated files from cmake
/build
/build-*
/cmake-build-debug*
/cmake-build-release*

# Ignore generated files from application
/debug
/tools/benchmark/rust/target

# Generated files from the paper build; the figure PDFs under paper/figures are checked in on purpose
/paper/**/*.aux
/paper/**/*.bbl
/paper/**/*.blg
/paper/**/*.fdb_latexmk
/paper/**/*.fls
/paper/**/*.log
/paper/**/*.out
/paper/**/*.pdf
/paper/**/*.toc
!/paper/figures/*.pdf

# Python bytecode from the probe analysis scripts.
__pycache__/
*.pyc
